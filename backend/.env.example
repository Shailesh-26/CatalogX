# ── Required ─────────────────────────────────────────────
# Local MongoDB (needs the MongoDB service running) or an Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/catalogx
# Any long random string, e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=5000

# Frontend URL(s) allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:3000

# ── Email (Gmail App Password, not your normal password) ─
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ── Cloudinary (book cover uploads) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Gemini AI (book summaries / recommendations) ─────────
GEMINI_API_KEY=
# Optional: override the model (run `npm run models` to list what your key can use)
GEMINI_MODEL=gemini-2.5-flash

# Optional: timezone for the 9 AM reminder job, or set DISABLE_CRON=true
CRON_TZ=Asia/Kolkata
